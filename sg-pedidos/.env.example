# ============================================================
# Sistema de Pedidos — Configuración por Cliente
# ============================================================
# Copia este archivo como .env.local y llena los valores.
# Reinicia el servidor de desarrollo después de cambiar valores.
# ============================================================

# --- Supabase (obligatorio) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- Datos del negocio ---
VITE_BUSINESS_NAME="Mi Imprenta"
VITE_BUSINESS_RFC=""
VITE_BUSINESS_EMAIL=""
VITE_BUSINESS_ADDRESS="Calle Ejemplo #123, Col. Centro, Ciudad, Estado"
VITE_BUSINESS_PHONE="(123) 456 7890"
VITE_BUSINESS_LOGO_URL="./logo.png"
VITE_BUSINESS_SOCIALS="FB: @miImprenta • IG: @miImprenta"

# --- Cotizador ---
VITE_BUSINESS_SERIES="COT"
VITE_BUSINESS_TAX_RATE="0.16"
